# Environment configuration template
# Copy this file to .env for local development, or add these variables in Vercel Project Settings -> Environment Variables.

# Secret key used by Flask to sign session cookies (use a long random string in production)
SECRET_KEY=generate_a_secure_random_string_here

# Local MongoDB connection (for local development only)
# MONGO_URI=mongodb://localhost:27017/expense_tracker

# Cloud MongoDB Atlas connection (REQUIRED for Vercel deployment)
# Replace <db_username>, <db_password>, and <cluster-url> with your MongoDB Atlas details:
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/expense_tracker?retryWrites=true&w=majority
